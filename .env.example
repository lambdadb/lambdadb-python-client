# LambdaDB live integration test configuration
#
# Copy this file to .env or .env.local and fill in your project credentials.
# .env and .env.local are ignored by git.

LAMBDADB_RUN_LIVE_TESTS=0
LAMBDADB_RUN_EXTERNAL_INTEGRATION_TESTS=0
LAMBDADB_PROJECT_API_KEY=
LAMBDADB_PROJECT_NAME=
LAMBDADB_BASE_URL=https://api.lambdadb.ai
