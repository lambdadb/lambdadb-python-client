  },
  "schemas": {
    "RerankConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "queryText",
        "fields"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "typesafe",
            "cohere"
          ],
          "description": "Native reranking provider. The server handles provider credentials; no customer provider API key is required."
        },
        "model": {
          "type": "string",
          "enum": [
            "jev-1.13.0",
            "rerank-v5.0-pro",
            "rerank-v5.0-fast"
          ],
          "description": "Explicit native reranking model; typesafe uses jev-1.13.0, cohere uses rerank-v5.0-pro or rerank-v5.0-fast."
        },
        "queryText": {
          "type": "string",
          "minLength": 1,
          "x-maxUtf8Bytes": 8192,
          "description": "Nonblank query text, at most 8 KiB UTF-8; required even for raw-vector retrieval."
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Ordered unique stored scalar string paths through objects; index configs are optional. Declared leaves must be text or keyword. The server validates ancestors and candidate values before provider dispatch."
        },
        "candidateSize": {
          "type": "integer",
          "nullable": true,
          "minimum": 1,
          "maximum": 1000,
          "description": "Merged rerank candidate cap, up to 1000; defaults to max(50, size). Must be at least size; does not change knn.k."
        },
        "onFailure": {
          "type": "string",
          "nullable": true,
          "enum": [
            "error",
            "returnOriginal"
          ],
          "description": "Defaults to error. returnOriginal applies only to whole-stage provider failures, not input, quota, admission, retrieval or authorization errors."
        },
        "criteria": {
          "type": "array",
          "nullable": true,
          "minItems": 2,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "x-maxUtf8Bytes": 2048
          },
          "x-maxUtf8Bytes": 8192,
          "description": "TypeSafe/Jev only; Cohere requires omitted/null. Distinct nonblank descriptions ordered lowest to highest relevance. Omitted/null uses default criteria; at most 2 KiB each and 8 KiB total UTF-8."
        }
      },
      "x-providerModels": {
        "typesafe": [
          "jev-1.13.0"
        ],
        "cohere": [
          "rerank-v5.0-pro",
          "rerank-v5.0-fast"
        ]
      },
      "x-criteriaProviders": [
        "typesafe"
      ]
    },
    "RerankResponse": {
      "type": "object",
      "required": [
        "status",
        "provider",
        "model",
        "candidateCount",
        "scoredCount",
        "took"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "skipped",
            "fallback"
          ],
          "description": "Check status before interpreting scores: fallback keeps search scores."
        },
        "provider": {
          "type": "string",
          "description": "Requested provider."
        },
        "model": {
          "type": "string",
          "description": "Requested model."
        },
        "resolvedModel": {
          "type": "string",
          "nullable": true,
          "description": "Resolved model when reported by the provider."
        },
        "candidateCount": {
          "type": "integer",
          "description": "Actual unique candidates in the logical stage; not a guaranteed count or billing unit."
        },
        "scoredCount": {
          "type": "integer",
          "description": "Complete accepted scores; equals candidateCount on applied, zero on skipped/fallback."
        },
        "took": {
          "type": "integer",
          "description": "Rerank stage duration in milliseconds, excluding candidate hydration."
        },
        "criteriaVersion": {
          "type": "string",
          "nullable": true,
          "enum": [
            "default-relevance-v1",
            "custom",
            "cohere-relevance-v1"
          ],
          "description": "Only on applied results when reported. TypeSafe/Jev uses default-relevance-v1 or custom; custom identifies caller-supplied criteria, not a content hash or unique version. Cohere uses cohere-relevance-v1."
        },
        "reason": {
          "type": "string",
          "nullable": true,
          "description": "Skipped/fallback reason: noCandidates, timeout, rateLimit, unavailable, invalidResponse or credentials."
        }
      }
    }
  }
}
